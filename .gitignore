# 依赖与构建产物
node_modules/
pnpm-lock.yaml
package-lock.json
yarn.lock

# 运行时生成的数据（含具体会话 id，不该进仓库）
# 0.3.0 起：每条规则一个 txt，全部落在 rules/ 目录
rules/
!rules/.gitkeep

# 旧版（0.1.x–0.2.x）的单文件存储，仅本地遗留
rules.json
rules.json.tmp
rules.json.migrated

# 安装器写的补丁备份
*.bak

# 设计期的取证脚本（仅本地留档；仓库里没有它们运行起来也完全正常）
probe/

# 临时/日志
*.log
.DS_Store
Thumbs.db
